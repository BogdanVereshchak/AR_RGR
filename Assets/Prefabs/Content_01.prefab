  m_text: "\u0410\u0440\u0442\u0435\u0444\u0430\u043A\u0442 \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C
    \u0434\u043E \u043A\u043E\u043B\u0435\u043A\u0446\u0456\u0457 \u0406\u043D\u0434\u0456\u0439\u0441\u044C\u043A\u043E\u0433\u043E
    \u043C\u0443\u0437\u0435\u044E \u0432 \u041A\u0430\u043B\u044C\u043A\u0443\u0442\u0442\u0456
    \u2014 \u043D\u0430\u0439\u0441\u0442\u0430\u0440\u0456\u0448\u043E\u0433\u043E
    \u043C\u0443\u0437\u0435\u044E \u0410\u0437\u0456\u0457. \u0423 2015 \u0440\u043E\u0446\u0456
    \u0435\u043A\u0441\u043F\u043E\u043D\u0430\u0442 \u0441\u0442\u0430\u0432 \u0447\u0430\u0441\u0442\u0438\u043D\u043E\u044E
    \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u043D\u043E\u0457 \u043C\u0456\u0436\u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0457
    \u0432\u0438\u0441\u0442\u0430\u0432\u043A\u0438 \xAB\u0421\u043A\u0430\u0440\u0431\u0438
    \u043D\u0430\u0439\u0441\u0442\u0430\u0440\u0456\u0448\u043E\u0433\u043E \u043C\u0443\u0437\u0435\u044E
    \u0410\u0437\u0456\u0457: \u0411\u0443\u0434\u0434\u0456\u0439\u0441\u044C\u043A\u0435
    \u043C\u0438\u0441\u0442\u0435\u0446\u0442\u0432\u043E \u0437 \u0406\u043D\u0434\u0456\u0439\u0441\u044C\u043A\u043E\u0433\u043E
    \u043C\u0443\u0437\u0435\u044E \u0432 \u041A\u0430\u043B\u044C\u043A\u0443\u0442\u0442\u0456\xBB,
    \u044F\u043A\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u0430 \u0432
    \u041C\u0443\u0437\u0435\u0457 \u0430\u0437\u0456\u0439\u0441\u044C\u043A\u0438\u0445
    \u0446\u0438\u0432\u0456\u043B\u0456\u0437\u0430\u0446\u0456\u0439 \u0443 \u0421\u0456\u043D\u0433\u0430\u043F\u0443\u0440\u0456.\r\n"
