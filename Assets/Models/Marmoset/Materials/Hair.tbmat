    Channel;specular = 4
    Intensity = 1
    Color = 1 1 1
    Fresnel = 1
    Color;fresnel = 0.534775 0.534775 0.534775
    Conserve Energy = 1
@End

@Sub SROcclusion = SROcclusionMap
    Occlusion Map = @Tex file "../../Assets/Textures/PillarWoman_Hair_AO.tga" fileFull "D:/RyanReos_3DCG/CGTrader/RyanReos_PillarWoman/Assets/Textures/PillarWoman_Hair_AO.tga" srgb 1 filter 1 mip 1 aniso 4 wrap 1 visible 1 @EndTex
    Channel;occlusion = 0
    Occlusion = 1
    UV Set = 0
    Vertex Channel = 0
    Cavity Map = nil
    Channel;cavity = 0
    Diffuse Cavity = 1
    Specular Cavity = 1
@End

@Sub SRTransparency = SRTransparencyDither
