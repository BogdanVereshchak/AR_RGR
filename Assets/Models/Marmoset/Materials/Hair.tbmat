    Alpha Map = @Tex file "../../Assets/Textures/PillarWoman_Hair_opacity.tga" fileFull "D:/RyanReos_3DCG/CGTrader/RyanReos_PillarWoman/Assets/Textures/PillarWoman_Hair_opacity.tga" srgb 0 filter 1 mip 1 aniso 4 wrap 1 visible 1 @EndTex
    Channel = 0
