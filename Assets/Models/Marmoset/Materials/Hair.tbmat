@Sub SRSurface = SRSurfaceNormalMap
    Normal Map = @Tex file "../../Assets/Textures/PillarWoman_Hair_Normal.tga" fileFull "D:/RyanReos_3DCG/CGTrader/RyanReos_PillarWoman/Assets/Textures/PillarWoman_Hair_Normal.tga" srgb 0 filter 1 mip 1 aniso 4 wrap 1 visible 1 @EndTex
    Scale & Bias = 1
    Flip X = 0
    Flip Y = 1
    Flip Z = 0
    Generate Z = 0
    Object Space = 0
@End

@Sub SRAlbedo = SRAlbedoMap
    Albedo Map = @Tex file "../../Assets/Textures/PillarWoman_Hair_BaseColor.tga" fileFull "D:/RyanReos_3DCG/CGTrader/RyanReos_PillarWoman/Assets/Textures/PillarWoman_Hair_BaseColor.tga" srgb 1 filter 1 mip 1 aniso 4 wrap 1 visible 1 @EndTex
    Color = 1 1 1
@End

@Sub SRDiffusion = SRDiffusionLambertian
@End

@Sub SRTransmission = SRTransmissionSubsurfaceDiffusion
    Scatter Map = nil
    Scatter Depth (mm) = 1
    Scatter Color = 0.621333 0.671465 0.746315
    Fuzz Map = nil
    Fuzz = 2
    Fuzz Color = 0.462925 0.600539 0.611803
    Mask Fuzz with Gloss = 1
    Use Translucency = 0
    Mask Map = nil
    Channel;Mask = 0
    Mask = 1
    Invert;Mask = 0
    Use Albedo Alpha = 1
@End

@Sub SRReflection = SRReflectionAnisotropic
    Direction Map = @Tex file "../../Assets/Textures/PillarWoman_Hair_direction.tga" fileFull "D:/RyanReos_3DCG/CGTrader/RyanReos_PillarWoman/Assets/Textures/PillarWoman_Hair_direction.tga" srgb 0 filter 1 mip 1 aniso 4 wrap 1 visible 1 @EndTex
    Scale & Bias = 1
    Swap X/Y Direction = 0
    Anisotropy = 1
    Anisotropy Direction = 0
@End

@Sub SRMicrosurface = SRMicrosurfaceRoughnessMap
    Roughness Map = nil
    Channel = 0
    Roughness = 0.5
    Invert;roughness = 0
@End

@Sub SRReflectivity = SRReflectivitySpecularMap
