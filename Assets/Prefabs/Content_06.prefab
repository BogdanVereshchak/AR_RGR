  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041D\u0430\u0434\u0456\u0439\u043D\u0456\u0441\u0442\u044C: \u041D\u0430
    \u0432\u0456\u0434\u043C\u0456\u043D\u0443 \u0432\u0456\u0434 \u0491\u043D\u043E\u0442\u0430,
    \u043A\u043E\u043B\u0456\u0441\u0446\u0435\u0432\u0438\u0439 \u0437\u0430\u043C\u043E\u043A
    \u043D\u0435 \u0433\u0430\u0441\u043D\u0443\u0432 \u0432\u0456\u0434 \u0432\u0456\u0442\u0440\u0443
    \u0447\u0438 \u0434\u043E\u0449\u0443.\r\n\u0421\u043A\u0440\u0438\u0442\u043D\u0456\u0441\u0442\u044C:
    \u0412\u0456\u0434\u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C \u0434\u0438\u043C\u0443
    \u0442\u0430 \u0441\u0432\u0456\u0442\u043B\u0430 \u0432\u0456\u0434 \u0442\u043B\u0456\u044E\u0447\u043E\u0433\u043E
    \u0491\u043D\u043E\u0442\u0430 \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u043B\u0430
    \u0440\u043E\u0431\u0438\u0442\u0438 \u0437\u0430\u0441\u0456\u0434\u043A\u0438.\r\n\u0421\u0442\u0430\u0442\u0443\u0441:
    \u0427\u0435\u0440\u0435\u0437 \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0441\u0442\u044C
    \u0432\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u044F (\u0432\u0456\u043D
    \u043D\u0430\u0433\u0430\u0434\u0443\u0432\u0430\u0432 \u0433\u043E\u0434\u0438\u043D\u043D\u0438\u043A\u043E\u0432\u0438\u0439
    \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C), \u0442\u0430\u043A\u0430 \u0437\u0431\u0440\u043E\u044F
    \u0431\u0443\u043B\u0430 \u043D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E
    \u0434\u043E\u0440\u043E\u0433\u043E\u044E \u0456 \u0432\u0432\u0430\u0436\u0430\u043B\u0430\u0441\u044F
    \u043E\u0437\u043D\u0430\u043A\u043E\u044E \u0431\u0430\u0433\u0430\u0442\u0441\u0442\u0432\u0430.\r\n"
